{
  "manifest_version": 3,
  "name": "Lumen Browser Agent",
  "version": "0.0.1",
  "description": "Lumen's browser body for observing, acting, and keeping the agent visible in Chrome.",
  "permissions": ["tabs", "storage", "scripting", "alarms", "downloads", "debugger", "notifications", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/control_indicator.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Lumen side panel",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "src/sidepanel.html" }
}
